# Production Environment Variables для Render.com
# Скопируйте эти переменные в Render Dashboard -> Environment Variables

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=10000
API_VERSION=v1

# ============================================
# DATABASE - MongoDB Atlas
# ============================================
MONGODB_URI=mongodb+srv://omlineadmin:5MOHI036wc4yf3vh@kmo24.e0o4igm.mongodb.net/kmo24?retryWrites=true&w=majority&appName=kmo24

# ============================================
# REDIS CACHE
# ============================================
# Будет автоматически установлено Render при связывании Redis сервиса
REDIS_URL=redis://red-xxxxxxxxxxxx:6379

# ============================================
# JWT SECRETS
# ============================================
# ВАЖНО: Используйте Render's "Generate Value" для этих переменных
JWT_SECRET=<GENERATE_STRONG_SECRET>
JWT_REFRESH_SECRET=<GENERATE_STRONG_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
# Будет автоматически установлено через fromService в render.yaml
CORS_ORIGIN=https://kmo24-frontend.onrender.com

# ============================================
# DELIVERY API - Деловые Линии
# ============================================
DL_API_KEY=6CA4665F-F1F1-40AF-BF06-E3CD2B452599

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/data/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/app.log

# ============================================
# OPTIONAL: TELEGRAM NOTIFICATIONS
# ============================================
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHANNEL_ID=@your_channel_here
# TELEGRAM_SYNC_INTERVAL=900000

# ============================================
# OPTIONAL: EMAIL (SMTP)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@kmo24.ru
# SMTP_FROM_NAME=КМО24

# ============================================
# OPTIONAL: 1C INTEGRATION
# ============================================
# 1C_API_URL=https://your-1c-server.com/api
# 1C_API_USERNAME=api_user
# 1C_API_PASSWORD=api_password
# 1C_SYNC_INTERVAL=1800000

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Эти переменные для Frontend сервиса:

# NUXT_PUBLIC_API_BASE_URL=https://kmo24-backend.onrender.com/api/v1
# NUXT_PUBLIC_SITE_URL=https://kmo24-frontend.onrender.com
# NODE_ENV=production
